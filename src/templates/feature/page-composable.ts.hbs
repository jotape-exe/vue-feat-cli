import { ref } from 'vue'
import { use{{Name}}Service } from './use{{Name}}Service'

export function use{{Name}}Page() {
  const loading = ref(false)
  const error = ref<string | null>(null)

  const { items, selected, fetchAll, fetchById, create, update, remove } = use{{Name}}Service()

  async function load() {
    loading.value = true
    error.value = null
    try {
      await fetchAll()
    } catch (e) {
      error.value = (e as Error).message
    } finally {
      loading.value = false
    }
  }

  async function loadById(id: string) {
    loading.value = true
    error.value = null
    try {
      await fetchById(id)
    } catch (e) {
      error.value = (e as Error).message
    } finally {
      loading.value = false
    }
  }

  return {
    items,
    selected,
    loading,
    error,
    load,
    loadById,
    create,
    update,
    remove,
  }
}
